{
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_COMPANION_HOST=codex bash \"${PLUGIN_ROOT}/hooks/stop-owner.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_COMPANION_HOST=codex bash \"${PLUGIN_ROOT}/hooks/drain-completions.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_COMPANION_HOST=codex bash \"${PLUGIN_ROOT}/hooks/install-agent-codex.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "AGENT_COMPANION_HOST=codex bash \"${PLUGIN_ROOT}/hooks/install-deps.sh\"",
            "timeout": 55
          },
          {
            "type": "command",
            "command": "AGENT_COMPANION_HOST=codex bash \"${PLUGIN_ROOT}/hooks/drain-completions.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_COMPANION_HOST=codex bash \"${PLUGIN_ROOT}/hooks/drain-completions.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
