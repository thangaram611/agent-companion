{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_COMPANION_HOST=codex bash \"${PLUGIN_ROOT}/hooks/hook.sh\" post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_COMPANION_HOST=codex bash \"${PLUGIN_ROOT}/hooks/install-deps.sh\"",
            "timeout": 55
          },
          {
            "type": "command",
            "command": "AGENT_COMPANION_HOST=codex bash \"${PLUGIN_ROOT}/hooks/hook.sh\" session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_COMPANION_HOST=codex bash \"${PLUGIN_ROOT}/hooks/hook.sh\" prompt",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
