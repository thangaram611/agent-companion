{
  "name": "agent-companion",
  "version": "0.3.0",
  "description": "Delegate from Claude Code to OpenCode, GitHub Copilot CLI, Codex CLI, Google Antigravity or Claude Code. Claude starts a thread with your task and an absolute repo or worktree path, follows up in that thread, and brings the result back to your conversation.",
  "author": {
    "name": "thangaram611",
    "email": "thangaram611@gmail.com",
    "url": "https://github.com/thangaram611"
  },
  "homepage": "https://github.com/thangaram611/agent-companion",
  "repository": "https://github.com/thangaram611/agent-companion",
  "license": "MIT",
  "mcpServers": {
    "agent-bridge": {
      "type": "stdio",
      "command": "/bin/bash",
      "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/launch-agent-bridge.sh"],
      "timeout": 1320000,
      "env": {
        "AGENT_COMPANION_HOST": "claude"
      }
    }
  },
  "keywords": [
    "opencode",
    "copilot",
    "antigravity",
    "delegation",
    "mcp",
    "acp",
    "codex"
  ]
}
