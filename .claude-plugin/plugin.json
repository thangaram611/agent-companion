{
  "name": "agent-companion",
  "version": "0.2.0",
  "description": "Delegate in plain language from Claude Code to an OpenCode, GitHub Copilot, Codex CLI, or Google Antigravity companion. Give the subagent a task, an absolute repo or worktree path, and any companion or model preference. Continue the same subagent for follow-ups.",
  "author": {
    "name": "thangaram611",
    "email": "thangaram611@gmail.com",
    "url": "https://github.com/thangaram611"
  },
  "homepage": "https://github.com/thangaram611/agent-companion",
  "repository": "https://github.com/thangaram611/agent-companion",
  "license": "MIT",
  "mcpServers": {
    "agent-bridge": {
      "type": "stdio",
      "command": "/bin/bash",
      "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/launch-agent-bridge.sh"],
      "timeout": 1320000,
      "env": {
        "AGENT_COMPANION_HOST": "claude",
        "AGENT_COMPANION_OWNER_GRACE_MS": "120000"
      }
    }
  },
  "keywords": [
    "opencode",
    "copilot",
    "antigravity",
    "delegation",
    "mcp",
    "subagent",
    "acp",
    "codex"
  ]
}
